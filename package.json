{
  "name": "soluquim-api-sds",
  "version": "0.1.0",
  "description": "Microservicio de generación de Fichas de Datos de Seguridad (FDS / SDS) — Soluquim",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && nest build",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "start:dev": "nest start --watch --entryFile main.api",
    "worker:dev": "nest start --watch --entryFile main.worker",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "start:debug": "nest start --watch --debug 0.0.0.0:9229 --entryFile main.api",
    "clean": "rm -rf dist/* dist/.[!.]* 2>/dev/null || true",
    "prestart:dev": "npm run clean",
    "prestart:debug": "npm run clean"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "cheerio": "^1.2.0",
    "cockatiel": "^3.2.1",
    "domhandler": "^5.0.3",
    "json5": "^2.2.3",
    "nestjs-pino": "^5.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@scarf/scarf": false,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0"
  }
}
