# ===========================================
# Variables de entorno — soluquim-api-sds
# Copia este archivo a .env (mismo patrón que soluquim-api-core/.env).
#
# Aquí va SOLO lo propio del servicio. La conexión a la BD y a RabbitMQ, los puertos
# y los flags de datos/arranque (APP_SEED_ENABLED, APP_SEED_DEMO, DB_RESET) vienen
# del .env RAÍZ de soluquim-docker vía `environment:`, que pisa a este archivo.
# ===========================================

# --- Logs ---
LOG_LEVEL=info              # fatal | error | warn | info | debug | trace

# --- Swagger (/api/sds/docs y /v3/api-docs) ---
SWAGGER_ENABLED=true

# --- Fuentes de datos ---
# Fuentes que se consultan, separadas por coma, o * para todas las activas por defecto.
# Ver GET /api/sds/v1/sources. OSHA está apagada por defecto (bloquea clientes que no son navegador):
# solo entra si se la nombra, p. ej. SOURCES_ENABLED=PUBCHEM,ECHA,ICSC,NIOSH_NPG,INSST_LEP,COMPTOX,IARC,NIST,OSHA
SOURCES_ENABLED=*

# --- Worker ---
# Mensajes que procesa a la vez cada worker (prefetch). Un job de FDS tarda minutos: mantenerlo bajo.
WORKER_CONCURRENCY=2

# --- Reintentos de tareas (RabbitMQ) — mismos defaults que soluquim-commons ---
# MESSAGING_MAX_ATTEMPTS=3
# MESSAGING_INITIAL_BACKOFF_MS=2000
# MESSAGING_BACKOFF_MULTIPLIER=2
# MESSAGING_MAX_BACKOFF_MS=10000

# --- IA: ajustes propios de este servicio ---
# El PROVEEDOR, la CLAVE y los MODELOS (AI_PROVIDER, OPENROUTER_API_KEY, AI_LLM_MODEL,
# AI_EMBEDDING_MODEL, AI_EMBEDDING_DIMENSIONS, SDS_AI_AGENT_MODELS) van en el .env RAÍZ de
# soluquim-docker, bloque "IA COMPARTIDA": son los mismos para todos los micros.
# AI_LLM_TEMPERATURE=0.2
# AI_LLM_MAX_OUTPUT_TOKENS=8000
# Caracteres máximos de contexto del RAG por llamada al agente (~4 por token). Más = más contexto y costo.
# AI_CONTEXT_MAX_CHARS=60000
# Llamadas simultáneas al LLM por proceso (una FDS hace ~6).
# AI_LLM_MAX_CONCURRENCY=3

# --- Claves de fuentes externas (aún no se usan) ---
# COMPTOX_API_KEY=
